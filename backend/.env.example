NODE_ENV=production

# ─── URLs ────────────────────────────────────────────────────────────────────
BACKEND_URL=https://api.seudominio.com.br
FRONTEND_URL=https://app.seudominio.com.br
PROXY_PORT=443
PORT=4000

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=troque_por_uma_string_aleatoria_longa
JWT_REFRESH_SECRET=troque_por_outra_string_aleatoria_longa

# ─── Banco de dados (PostgreSQL) ──────────────────────────────────────────────
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atalk
DB_USER=atalk
DB_PASS=troque_pela_senha_do_banco
DB_TIMEZONE=-03:00
DB_DEBUG=false

# ─── Redis ───────────────────────────────────────────────────────────────────
# Sem senha:  redis://127.0.0.1:6379
# Com senha:  redis://:suasenha@127.0.0.1:6379
REDIS_URI=redis://127.0.0.1:6379
REDIS_OPT_LIMITER_MAX=1
REDIS_OPT_LIMITER_DURATION=3000

# ─── Limites ─────────────────────────────────────────────────────────────────
USER_LIMIT=100
CONNECTIONS_LIMIT=10
CLOSED_SEND_BY_ME=true

# ─── Sentry (opcional) ───────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Gerencianet / Pix (opcional) ────────────────────────────────────────────
GERENCIANET_SANDBOX=false
GERENCIANET_CLIENT_ID=
GERENCIANET_CLIENT_SECRET=
GERENCIANET_PIX_CERT=

# ─── Digital Ocean Spaces (armazenamento de mídias) ──────────────────────────
DO_SPACES_ENDPOINT=nyc3.digitaloceanspaces.com
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_CDN=

# ─── InfoSimples (certidões) ──────────────────────────────────────────────────
INFOSIMPLES_API_KEY=
INFOSIMPLES_API_URL=https://api.infosimples.com/api/v2
INFOSIMPLES_TIMEOUT=60000
INFOSIMPLES_MAX_CONSULTAS_MES=1000
INFOSIMPLES_ALERT_THRESHOLD=800
INFOSIMPLES_RETRY_ATTEMPTS=3
INFOSIMPLES_RETRY_DELAY=5000
CERTIDOES_RETRY_DAYS=10
