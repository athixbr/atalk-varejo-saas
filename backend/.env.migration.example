# ═══════════════════════════════════════════════════════════════
# CREDENCIAIS MYSQL PARA MIGRAÇÃO DE CLIENTES
# ═══════════════════════════════════════════════════════════════
# 
# ⚠️  ATENÇÃO: Este arquivo contém credenciais sensíveis!
# ⚠️  NÃO COMMITAR NO GIT (já está no .gitignore)
#
# 📝 Configure as credenciais do MySQL externo abaixo:
# ═══════════════════════════════════════════════════════════════

# Host do servidor MySQL
MYSQL_HOST=localhost

# Porta do MySQL (padrão: 3306)
MYSQL_PORT=3306

# Usuário do MySQL
MYSQL_USER=root

# Senha do MySQL
MYSQL_PASSWORD=sua_senha_aqui

# Nome do banco de dados
MYSQL_DATABASE=contco
