# ============================================
# CONFIGURAÇÃO DO DIGITAL OCEAN SPACES (GED)
# ============================================

# Endpoint do Digital Ocean Spaces (ex: nyc3.digitaloceanspaces.com)
DO_SPACES_ENDPOINT=nyc3.digitaloceanspaces.com

# Nome do bucket/space criado no Digital Ocean
DO_SPACES_BUCKET=atalk

# Access Key do Digital Ocean Spaces
DO_SPACES_KEY=your_access_key_here

# Secret Key do Digital Ocean Spaces
DO_SPACES_SECRET=your_secret_key_here

# URL do CDN (opcional - deixe vazio para usar o endpoint padrão)
# Ex: https://atalk.nyc3.cdn.digitaloceanspaces.com
DO_SPACES_CDN=

# ============================================
# COMO CONFIGURAR:
# ============================================
# 1. Acesse https://cloud.digitalocean.com/spaces
# 2. Crie um novo Space (ou use existente)
# 3. Anote o nome do Space e o endpoint
# 4. Vá em API > Spaces Keys
# 5. Gere uma nova chave de acesso
# 6. Copie a Key e Secret para este arquivo
# ============================================
