# ─── Backend ──────────────────────────────────────────────────────────────────
# URL pública do backend (obrigatório)
REACT_APP_BACKEND_URL=https://api.seudominio.com.br

# ─── Servidor Express (docker-server.js) ──────────────────────────────────────
SERVER_PORT=3000

# ─── Personalização visual (opcional) ────────────────────────────────────────
REACT_APP_PRIMARY_COLOR=#0C2454
REACT_APP_PRIMARY_DARK=#0C2454

# ─── Funcionalidades opcionais ────────────────────────────────────────────────
# Número do WhatsApp de suporte (exibido na tela de login)
REACT_APP_NUMBER_SUPPORT=

# Horas para fechar tickets automaticamente
REACT_APP_HOURS_CLOSE_TICKETS_AUTO=

# App ID do Facebook (login social)
REACT_APP_FACEBOOK_APP_ID=
